# ============================================================================
# The Shelf — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================================

# MongoDB connection string
# For Docker: mongodb://mongo:27017/the-shelf  (uses the compose service name)
# For local:  mongodb://localhost:27017/the-shelf
# For Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/the-shelf
MONGODB_URI=mongodb://localhost:27017/the-shelf

# JWT signing secret — MUST be changed in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-strong-random-secret

# Session token lifetime (e.g., 1h, 24h, 7d)
SESSION_DURATION=24h

# Environment
NODE_ENV=development

# Base URL of the app — used in password-reset emails sent by the server.
# Set this to the public-facing URL (with port if non-standard).
# Examples:
#   Local dev:  http://localhost:3000
#   Docker:     http://YOUR_HOST_IP:3000
#   HTTPS demo: https://YOUR_HOST_IP:3443
APP_BASE_URL=http://localhost:3000

# Email (for password reset — optional for local dev)
# EMAIL_USER=your-gmail@gmail.com
# EMAIL_PASS=your-app-password
